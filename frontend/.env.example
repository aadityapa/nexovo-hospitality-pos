# ---- API mode -------------------------------------------------------------
# mock  = in-browser backend (no server needed, data persisted in localStorage)
# ords  = Oracle REST Data Services backend (see database/README)
VITE_API_MODE=mock

# Base URL of the ORDS module (only used when VITE_API_MODE=ords)
VITE_API_BASE_URL=http://localhost:8080/ords/pos/v1

# Public URL used inside QR codes (customer-facing). Must be reachable by phones.
# Leave EMPTY to use whatever address you are browsing on — open the app on your PC's LAN
# address (e.g. http://192.168.1.5:5173) and the QR codes will point there automatically.
# Set it explicitly only for a deployed public URL, e.g. https://menu.yourvenue.com
VITE_PUBLIC_APP_URL=

# Realtime transport: broadcast (mock) | polling (ords) | none
VITE_REALTIME_MODE=broadcast
VITE_REALTIME_POLL_MS=5000

# Simulated network latency for mock mode (ms)
VITE_MOCK_LATENCY_MS=150

VITE_APP_NAME=Nexovo POS
