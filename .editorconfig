# EditorConfig — https://editorconfig.org
#
# These settings describe the style the codebase already uses. Verified against the tree: no file
# under frontend/src uses tab indentation, every source file ends with a newline, and the SQL and
# Markdown follow the same two-space, LF, UTF-8 convention.
#
# There is no ESLint or Prettier configuration in this repository, so this file and the house rules
# in CONTRIBUTING.md are the whole of the style enforcement.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Windows batch files are CRLF on disk — see .gitattributes for why.
[*.{bat,cmd}]
end_of_line = crlf

# Markdown uses two trailing spaces as a hard line break, so trailing whitespace is meaningful.
[*.md]
trim_trailing_whitespace = false

# Generated; leave it exactly as npm writes it.
[**/package-lock.json]
insert_final_newline = ignore
trim_trailing_whitespace = false
